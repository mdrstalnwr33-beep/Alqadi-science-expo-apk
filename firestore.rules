rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // التطبيق يستخدم رمز المدرسة بدل Firebase Authentication.
    // يجب تضييق هذه القواعد لاحقًا عند إضافة مصادقة حقيقية.
    match /students/{id} { allow read, create, update, delete: if true; }
    match /access_codes/{id} { allow read, create, update, delete: if true; }
    match /content/{id} { allow read, create, update, delete: if true; }
    match /homeworks/{id} { allow read, create, update, delete: if true; }
    match /homeworkSubmissions/{id} { allow read, create, update, delete: if true; }
    match /exams/{id} { allow read, create, update, delete: if true; }
    match /examAttempts/{id} { allow read, create, update, delete: if true; }
    match /grades/{id} { allow read, create, update, delete: if true; }
    match /settings/{id} { allow read, create, update, delete: if true; }
  }
}
