rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app currently uses its own school login/code system rather than
    // Firebase Authentication. Keep the database usable by the mobile app.
    // Sensitive teacher access is enforced in the app UI; these rules are
    // intentionally simple for this single-school deployment.
    match /students/{id} {
      allow read, create, update, delete: if true;
    }
    match /access_codes/{id} {
      allow read, create, update, delete: if true;
    }
    match /content/{id} {
      allow read, create, update, delete: if true;
    }
    match /homeworks/{id} {
      allow read, create, update, delete: if true;
    }
    match /homeworkSubmissions/{id} {
      allow read, create, update, delete: if true;
    }
    match /settings/{id} {
      allow read, create, update, delete: if true;
    }
    match /grades/{id} {
      allow read, create, update, delete: if true;
    }
  }
}
