rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app currently authenticates by school codes, so these collections must be readable by the app.
    // Replace with Firebase Authentication role checks before public multi-school deployment.
    match /lessons/{id} { allow read, write: if true; }
    match /homework/{id} { allow read, write: if true; }
    match /exams/{id} { allow read, write: if true; }
    match /bookLinks/{id} { allow read, write: if true; }
    match /notifications/{id} { allow read, write: if true; }
    match /examAttempts/{id} { allow read, write: if true; }
    match /homeworkSubmissions/{id} { allow read, write: if true; }
    match /content/{id} { allow read: if true; allow write: if false; }
    match /publicContent/{id} { allow read: if true; allow write: if true; }

    // Student accounts and the teacher access code are cloud-synchronized.
    // The app currently uses school/student codes instead of Firebase Authentication.
    match /students/{id} { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }

    match /{document=**} { allow read, write: if false; }
  }
}
