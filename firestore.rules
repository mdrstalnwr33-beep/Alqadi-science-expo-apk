rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary baseline: deploy stricter role-based rules before public release.
    match /publicContent/{document=**} { allow read: if true; allow write: if false; }
    match /content/{document=**} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
