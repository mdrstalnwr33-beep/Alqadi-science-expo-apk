{
  "expo": {
    "name": "تطبيق القاضي للعلوم",
    "slug": "alqadi-science-app",
    "version": "0.5.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {"image":"./assets/icon.png","resizeMode":"contain","backgroundColor":"#1E3A8A"},
    "android": {
      "package": "com.nourascience.app",
      "versionCode": 13,
      "supportsRtl": true,
      "adaptiveIcon": {"foregroundImage":"./assets/adaptive-icon-foreground.png","backgroundColor":"#1E3A8A"}
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      ["expo-build-properties", {"android":{"buildArchs":["armeabi-v7a","arm64-v8a"],"enableBundleCompression":true,"enableMinifyInReleaseBuilds":false,"useLegacyPackaging":true}}]
    ]
  }
}
