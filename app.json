{
  "expo": {
    "name": "تطبيق القاضي للعلوم",
    "slug": "alqadi-science-app",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./app-profile.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app-profile.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "android": {
      "package": "com.nourascience.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./app-profile.jpg",
        "backgroundColor": "#1E3A8A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ]
  }
}
