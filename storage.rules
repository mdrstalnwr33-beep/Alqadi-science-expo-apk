rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher() { return request.auth != null && request.auth.token.teacher == true; }
    match /materials/{level}/{subject}/{fileName} {
      allow read: if request.auth != null;
      allow write: if teacher() && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }
    match /teacher/{fileName} {
      allow read: if true;
      allow write: if teacher() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
